# Copy this file to the repository ROOT .env (ignored), not supabase/.env.
# The Supabase CLI reads root .env for config.toml env() references.
# These values belong only to the local Supabase Auth server. Never use VITE_*.
# A real Google registration is required; blank values do not enable the provider.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
