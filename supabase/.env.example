# Server-side audio-cleanup runtime values only. Never expose these to the browser.
# For local OAuth provider credentials use auth.env.example -> repository ROOT .env.
# The CLI reads root .env for config.toml; supabase/.env is not its default input.

# Supabase project URL used by the server-side cleanup function.
SUPABASE_URL=

# Service-role key: server-only; never put this in web/.env or client code.
SUPABASE_SERVICE_ROLE_KEY=

# Shared cleanup secret: use a random value of at least 32 bytes at runtime.
BASIRA_AUDIO_CLEANUP_SECRET=
