# Server/runtime values only. Never expose these values to the browser or commit a populated .env file.
# Copy this file to a local, ignored .env only when running the cleanup function locally.

# Supabase project URL used by the server-side cleanup function.
SUPABASE_URL=

# Service-role key: server-only; never put this in web/.env or client code.
SUPABASE_SERVICE_ROLE_KEY=

# Shared cleanup secret: use a random value of at least 32 bytes at runtime.
BASIRA_AUDIO_CLEANUP_SECRET=
