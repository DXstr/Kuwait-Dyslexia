# Copy to web/.env.local (ignored) to connect the real Supabase Auth server.
# VITE_* values are PUBLIC and bundled into browser JavaScript.
# Use the project's publishable key or legacy anon key, never a secret/service-role key.
# Leave both blank for an honest unconfigured UI with disabled sign-in controls.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OAuth client secrets belong in the repository ROOT .env for local Supabase,
# not in web/.env.local. See ../supabase/auth.env.example and ../supabase/README.md.

# Fixture mode never sends audio, metadata or tokens to the scorer URL.
# Preconfigure the real URL, then change only MODE to real; no code change.
# Local development: http://localhost:8000. Deployment: an operator-configured HTTPS URL.
# The scorer must allow this frontend origin in ALLOWED_ORIGINS.
VITE_SCORER_MODE=mock
VITE_SCORER_URL=http://localhost:8000
# VITE_SCORER_BASE_URL is not supported; the canonical OpenAPI name is VITE_SCORER_URL.
