# B1 needs no environment variables. Copy to .env.local only for later tasks.
# Never commit .env.local or secrets. VITE_* values are public browser values.
# Supabase Auth, database and storage are B3/B4; never expose a service-role key.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Scorer integration and labelled fixture mode are B5, not implemented in B1.
# VITE_SCORER_MODE=mock
# VITE_SCORER_BASE_URL=
