# Copy to .env (root/ai) or web/.env.local. Never commit real values.

# --- web (B) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SCORER_URL=http://localhost:8000
VITE_SCORER_MODE=mock            # mock | real

# --- scorer (A) ---
SUPABASE_JWKS_URL=               # https://<project>.supabase.co/auth/v1/.well-known/jwks.json
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=120
MODEL_ID=                        # recorded in docs/DISCLOSURES.md with its licence
