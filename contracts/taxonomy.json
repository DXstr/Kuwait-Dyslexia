  "error_categories": [
    {
      "id": "dot_confusion",
      "definition": "Produced letter shares the target's skeleton but differs in dots (same dot_group)."
    },
    {
      "id": "emphatic_confusion",
      "definition": "Emphatic letter produced as its plain pair or vice versa (emphatic_pairs)."
    },
    {
      "id": "short_vowel",
      "definition": "Wrong or missing short vowel. NOT detectable from audio with the current model; measured by tap tasks."
    },
    {
      "id": "positional",
      "definition": "Error rate on a letter that rises in a specific word position (initial/medial/final)."
    },
    {
      "id": "omission",
      "definition": "Expected phoneme not produced."
    },
    {
      "id": "insertion",
      "definition": "Extra phoneme produced."
    },
    {
      "id": "substitution",
      "definition": "Any other wrong phoneme, or a whole-word substitution."
    }
  ],
  "sources": [
    "Watson, J. (2002) The Phonology and Morphology of Arabic. OUP. (reference named in the Idea Lock; reviewer to confirm each row)"
